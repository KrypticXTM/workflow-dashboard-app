<Window x:Class="WorkflowDashboard.DocsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorkflowDashboard"
        Title="Files"
        Width="720" Height="640"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontWeight="SemiBold"
        PreviewKeyDown="Window_PreviewKeyDown">
  <!-- Frameless themed chrome (no light OS caption): drag/double-click/system menu come from WindowChrome,
       resize borders stay; the caption matches the main dashboard's custom title bar. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="28" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
  </WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource BorderBrushQuiet}" BorderThickness="1">
  <DockPanel>
  <Border x:Name="FilesTitleBar" DockPanel.Dock="Top" Height="28" Background="{DynamicResource TitleBarBrush}"
          BorderBrush="{DynamicResource BorderBrushQuiet}" BorderThickness="0,0,0,1">
    <DockPanel LastChildFill="True">
      <Button x:Name="BtnFilesTitleClose" DockPanel.Dock="Right" Style="{StaticResource TitleBarButton}" Tag="close"
              Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
        <Path Width="10" Height="10" Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.1"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
        <Border Width="9" Height="9" CornerRadius="3" Margin="0,0,9,0" VerticalAlignment="Center"
                Background="{DynamicResource AccentBrush}" Effect="{DynamicResource AccentGlowEffect}"/>
        <TextBlock Text="Files" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}"/>
      </StackPanel>
    </DockPanel>
  </Border>
  <!-- Clipboard metaphor: dark desk chrome + metal clip + theme-tinted paper well -->
  <DockPanel Margin="10">
    <!-- Banner / clip head -->
    <Border DockPanel.Dock="Top" Margin="0" Padding="0" CornerRadius="6,6,0,0"
            BorderBrush="{DynamicResource BorderBrushQuiet}" BorderThickness="1,1,1,0"
            Background="{DynamicResource PanelAltBrush}">
      <Grid>
        <Border CornerRadius="6,6,0,0" IsHitTestVisible="False">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <!-- Shading only over the themed PanelAlt fill (was fixed dark brown, so dark-accent text vanished). -->
              <GradientStop Color="#0A000000" Offset="0"/>
              <GradientStop Color="#26000000" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- Larger metal clipboard clip — rivets are rings (not speckles); strong accent spring -->
        <Canvas HorizontalAlignment="Center" VerticalAlignment="Top" Width="108" Height="40" Margin="0,-6,0,0"
                IsHitTestVisible="False">
          <Border Canvas.Left="18" Canvas.Top="4" Width="72" Height="26" CornerRadius="5"
                  BorderThickness="1.5" BorderBrush="#9A9688">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#7A7668" Offset="0"/>
                <GradientStop Color="#4E4C44" Offset="0.55"/>
                <GradientStop Color="#3A3830" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
              <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
          </Border>
          <!-- Rivet: dark well + bright ring + metal core -->
          <Ellipse Canvas.Left="26" Canvas.Top="11" Width="10" Height="10" Fill="#2A2820" Stroke="#C8C4B4" StrokeThickness="1.5"/>
          <Ellipse Canvas.Left="28.5" Canvas.Top="13.5" Width="5" Height="5" Fill="#A8A490"/>
          <Ellipse Canvas.Left="72" Canvas.Top="11" Width="10" Height="10" Fill="#2A2820" Stroke="#C8C4B4" StrokeThickness="1.5"/>
          <Ellipse Canvas.Left="74.5" Canvas.Top="13.5" Width="5" Height="5" Fill="#A8A490"/>
          <!-- Accent spring -->
          <Border Canvas.Left="42" Canvas.Top="8" Width="24" Height="16" CornerRadius="3"
                  Background="{DynamicResource AccentBrush}" Opacity="1"
                  BorderBrush="#FFFFFF" BorderThickness="0.5">
            <Border.Effect>
              <DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
          </Border>
          <Border Canvas.Left="45" Canvas.Top="10" Width="18" Height="4" CornerRadius="1.5"
                  Background="#FFFFFF" Opacity="0.45"/>
          <Border Canvas.Left="46" Canvas.Top="18" Width="16" Height="2" CornerRadius="1"
                  Background="#000000" Opacity="0.25"/>
        </Canvas>

        <DockPanel Margin="0,26,0,0">
          <Border DockPanel.Dock="Top" Height="2" Margin="18,0,18,0"
                  Background="{DynamicResource AccentBrush}" Opacity="0.75"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="72" Margin="14,8,14,12">
            <TextBlock Text="&#x25C8;  Preview" FontSize="10" FontWeight="Bold" Opacity="0.75"
                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
              <Button x:Name="BtnCyclePrev" Content="&#x25C0;" Width="36" Height="28"
                      Margin="0,0,10,0" Padding="0" Click="CyclePrev_Click" Visibility="Collapsed"
                      Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                      BorderBrush="{DynamicResource AccentBrush}" FontWeight="Bold"
                      ToolTip="Previous" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center" MaxWidth="280">
                <TextBlock x:Name="TxtTitle" Text="Files" FontSize="16" FontWeight="Bold"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="TxtSub" Text="Downloads" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,2,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="BtnCycleNext" Content="&#x25B6;" Width="36" Height="28"
                      Margin="10,0,0,0" Padding="0" Click="CycleNext_Click" Visibility="Collapsed"
                      Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                      BorderBrush="{DynamicResource AccentBrush}" FontWeight="Bold"
                      ToolTip="Next" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
              <StackPanel x:Name="HeaderAssignChips" Orientation="Horizontal" Margin="0,0,8,0" Visibility="Collapsed">
                <Button x:Name="BtnAssignPane1" Content="Pane 1" Height="28" MinWidth="56" Margin="0,0,4,0"
                        Padding="8,0" Click="AssignPane_Click" Tag="0"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                <Button x:Name="BtnAssignPane2" Content="Pane 2" Height="28" MinWidth="56" Margin="0,0,4,0"
                        Padding="8,0" Click="AssignPane_Click" Tag="1"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                <Button x:Name="BtnAssignPane3" Content="Pane 3" Height="28" MinWidth="56"
                        Padding="8,0" Click="AssignPane_Click" Tag="2"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" FontWeight="Bold"/>
              </StackPanel>
              <Button Content="Close" Width="72" Height="28" Padding="0"
                      Click="Close_Click" Background="{DynamicResource PanelAltBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrushQuiet}"/>
            </StackPanel>
            <!-- v1.0.2: themed segmented toggle - no black box; thin quiet outline, accent = selected (set in code). -->
            <Border x:Name="ModeToggleBar" HorizontalAlignment="Center" Visibility="Collapsed"
                    Background="Transparent" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushQuiet}" BorderThickness="1" Padding="1">
              <Border.Resources>
                <Style x:Key="SegBtn" TargetType="Button">
                  <Setter Property="Height" Value="24"/>
                  <Setter Property="MinWidth" Value="68"/>
                  <Setter Property="Padding" Value="10,0"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="Focusable" Value="False"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                          <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <MultiTrigger>
                            <MultiTrigger.Conditions>
                              <Condition Property="IsMouseOver" Value="True"/>
                              <Condition Property="Tag" Value="idle"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                          </MultiTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Border.Resources>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnModeWindows" Content="Windows" Style="{StaticResource SegBtn}" Margin="0,0,1,0"
                        Click="ModeWindows_Click" ToolTip="Preview Windows list"/>
                <Button x:Name="BtnModeDocs" Content="Docs" Style="{StaticResource SegBtn}"
                        Click="ModeDocs_Click" ToolTip="Preview Docs list"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>

    <!-- Outer surround: desk grey chrome (not manila) -->
    <Border CornerRadius="0,0,6,6" BorderBrush="{DynamicResource BorderBrushQuiet}" BorderThickness="1,0,1,1" Padding="0">
      <Border.Effect>
        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.35" Color="#000000" Direction="270"/>
      </Border.Effect>
      <Grid>
        <Border CornerRadius="0,0,6,6" Background="{DynamicResource PanelBrush}" IsHitTestVisible="False"/>
        <DockPanel Margin="8">
          <!-- Ruled lines only (no decorative dots) -->
          <Border DockPanel.Dock="Top" Height="14" Margin="4,0,4,6" IsHitTestVisible="False">
            <Border.Background>
              <DrawingBrush TileMode="Tile" Viewport="0,0,1,14" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                  <GeometryDrawing>
                    <GeometryDrawing.Pen>
                      <Pen Brush="{DynamicResource BorderBrushQuiet}" Thickness="0.7"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                      <LineGeometry StartPoint="0,13" EndPoint="4000,13"/>
                    </GeometryDrawing.Geometry>
                  </GeometryDrawing>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Border.Background>
          </Border>

          <StackPanel x:Name="FileActions" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Add to Docs" Height="32" Margin="0,0,6,0"
                      Click="Add_Click"
                      Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                      BorderBrush="{DynamicResource AccentBrush}" FontWeight="Bold"/>
              <Button Grid.Column="1" Content="Preview" Height="32" Margin="6,0,0,0"
                      Click="Preview_Click"
                      Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                      BorderBrush="{DynamicResource AccentBrush}"/>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="PreviewActions" DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Add to Docs" Height="32" Margin="0,0,4,0"
                      Click="AddPreview_Click"
                      Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                      BorderBrush="{DynamicResource AccentBrush}" FontWeight="Bold"/>
              <Button Grid.Column="1" Content="Play / Pause" Height="32" Margin="4,0,4,0"
                      Click="PlayPause_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" FontWeight="Bold"/>
              <Button Grid.Column="2" Content="Back to files" Height="32" Margin="4,0,0,0"
                      Click="BackToFiles_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" FontWeight="Bold"/>
            </Grid>
          </StackPanel>

          <ListBox x:Name="FileList"
                   Background="Transparent" BorderBrush="{DynamicResource BorderBrushQuiet}" BorderThickness="1"
                   Foreground="{DynamicResource TextBrush}" FontSize="13"
                   MouseDoubleClick="FileList_MouseDoubleClick"
                   SelectionMode="Extended"/>

          <Grid x:Name="PreviewHost" Visibility="Collapsed" Background="Transparent">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Accent-tinted paper mat around live thumb / doc preview -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource PaperBorderBrush}" BorderThickness="1"
                    CornerRadius="2">
              <Grid>
                <Border Background="{DynamicResource PaperSurfaceBrush}" IsHitTestVisible="False"/>
                <Border Background="{DynamicResource AccentBrush}" Opacity="0.30" IsHitTestVisible="False"/>
                <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <local:ThumbnailHost x:Name="WindowThumb" Visibility="Collapsed"/>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              Stretch="Uniform" MediaEnded="Player_MediaEnded" Visibility="Collapsed"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" BorderThickness="0" Visibility="Collapsed" Padding="10"
                         Background="Transparent" Foreground="{DynamicResource PaperInkBrush}"
                         FontFamily="Consolas" FontSize="12"
                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
                <StackPanel x:Name="PreviewFallback" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="TxtFallback" Text="No inline preview" FontSize="14"
                             Foreground="{DynamicResource PaperInkBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                  <Button Content="Open with default app" Width="180" Height="32" Click="OpenExternal_Click"
                          Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                          BorderBrush="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Grid.Row="1" x:Name="TxtPreviewHint" FontSize="10"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="8,6,8,0"/>
          </Grid>
        </DockPanel>
      </Grid>
    </Border>
  </DockPanel>
  </DockPanel>
  </Border>
</Window>